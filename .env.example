# Copy to .env (git ignores it). Every app loads the repo-root .env.local and .env through packages/db/src/env.ts;
# a value already set (by the shell, or by .env.local) is never overwritten.
# CONTRIBUTING.md explains each variable.

# --- Solana RPC -------------------------------------------------------------------------------------------------
# A free Helius key makes the seed, backfill and indexer reliable; without one they use the rate-limited public RPC.
HELIUS_API_KEY=
# Leave these empty to use Helius (from HELIUS_API_KEY), or the public endpoints without a key. An explicit URL wins.
SOLANA_MAINNET_RPC_URL=
SOLANA_MAINNET_WS_URL=
SOLANA_DEVNET_RPC_URL=
SOLANA_DEVNET_WS_URL=

# --- Database ---------------------------------------------------------------------------------------------------
# Local: the docker-compose Postgres. Supabase: Connect → "Session pooler" string, password filled in.
# On Vercel use the "Transaction pooler" string (port 6543) here and the session pooler string as DIRECT_URL.
DATABASE_URL=postgres://overwatch:overwatch@localhost:5433/overwatch
DIRECT_URL=                 # optional; LISTEN (live events) and migrations; defaults to DATABASE_URL

# --- Alerts -----------------------------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=         # from @BotFather; the bot runs only when this is set
TELEGRAM_BOT_USERNAME=      # without the @; the site shows "Open @<name>" links when set
RESEND_API_KEY=             # optional; email alerts are off without it
RESEND_FROM=                # optional; defaults to "Overwatch <alerts@resend.dev>"
WEBHOOK_ALLOW_PRIVATE_URLS= # local development only: "true" lets webhooks call http:// and private hosts. Never set in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # used in alert links

# --- Indexer ----------------------------------------------------------------------------------------------------
INDEXER_PORT=               # optional; health endpoint port, default 8787
NONCE_PROGRAM_SUBSCRIBE=    # optional; "true" forces real-time nonce subscriptions on the public mainnet RPC

# --- Devnet registry, vault and demo (optional) -----------------------------------------------------------------
REGISTRY_PROGRAM_ID=ZCq8qg8ALrZp4FtKra2FERRREWU8c5bu75EQ9CR3q1X
VAULT_PROGRAM_ID=9HyNZKXgyJzCoSq3PQ16etGn7eC4ZDauTuRUUe9Jef5A
PUBLISHER_KEYPAIR_PATH=./keys/publisher-keypair.json     # devnet only
DEMO_ADMIN_KEYPAIR_PATH=./keys/demo-admin-keypair.json   # devnet only
DEMO_MODE=false             # "true" lets the indexer's keeper re-arm the demo vault after a reset
FUNDER_KEYPAIR_PATH=        # optional devnet keypair used to fund demo keys when airdrops are rate-limited
