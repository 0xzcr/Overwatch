HELIUS_API_KEY=
# Leave the SOLANA_*_URL lines empty to use Helius (from HELIUS_API_KEY), or the public endpoints without a key.
SOLANA_MAINNET_RPC_URL=
SOLANA_MAINNET_WS_URL=
SOLANA_DEVNET_RPC_URL=
SOLANA_DEVNET_WS_URL=
YELLOWSTONE_URL=            # optional
YELLOWSTONE_TOKEN=          # optional
# Local: the docker-compose Postgres below. Supabase: Connect → "Session pooler" string, password filled in.
# On Vercel use the "Transaction pooler" string (port 6543) here and the session pooler string as DIRECT_URL.
DATABASE_URL=postgres://overwatch:overwatch@localhost:5433/overwatch
DIRECT_URL=                 # optional; LISTEN (live events) and migrations; defaults to DATABASE_URL
REDIS_URL=                  # optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
RESEND_API_KEY=             # optional
REGISTRY_PROGRAM_ID=ZCq8qg8ALrZp4FtKra2FERRREWU8c5bu75EQ9CR3q1X
VAULT_PROGRAM_ID=9HyNZKXgyJzCoSq3PQ16etGn7eC4ZDauTuRUUe9Jef5A
PUBLISHER_KEYPAIR_PATH=./keys/publisher-keypair.json     # devnet only
DEMO_MODE=false
DEMO_ADMIN_KEYPAIR_PATH=./keys/demo-admin-keypair.json   # devnet only
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEVNET_RPC_URL=https://api.devnet.solana.com
FUNDER_KEYPAIR_PATH=          # optional devnet keypair used to fund demo keys when airdrops are rate-limited
