{
  "name": "overwatch",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "inspect": "tsx scripts/inspect.ts",
    "seed": "tsx scripts/seed-protocols.ts",
    "backfill": "tsx scripts/backfill.ts",
    "db:migrate": "pnpm --filter @overwatch/db migrate",
    "demo:setup": "tsx scripts/demo/setup.ts",
    "stats": "tsx scripts/headline-stats.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@overwatch/core": "workspace:*",
    "@overwatch/db": "workspace:*",
    "@overwatch/solana": "workspace:*",
    "@solana/web3.js": "^1.99.0",
    "@sqds/multisig": "^2.1.4",
    "bs58": "^6.0.0"
  }
}
