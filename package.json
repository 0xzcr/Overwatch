{
  "name": "overwatch",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api-key": "tsx scripts/api-key.ts",
    "backfill": "tsx scripts/backfill.ts",
    "build": "turbo run build",
    "db:migrate": "pnpm --filter @overwatch/db migrate",
    "dev": "turbo run dev",
    "fixtures:capture": "tsx scripts/capture-fixtures.ts",
    "fixtures:idl": "tsx scripts/dev/idl.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css}\"",
    "indexnow": "tsx scripts/indexnow.ts",
    "inspect": "tsx scripts/inspect.ts",
    "lint": "turbo run lint",
    "probe": "tsx scripts/dev/probe.ts",
    "seed": "tsx scripts/seed-protocols.ts",
    "smoke:pipeline": "tsx scripts/dev/pipeline-smoke.ts",
    "stats": "tsx scripts/headline-stats.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@overwatch/core": "workspace:*",
    "@overwatch/db": "workspace:*",
    "@overwatch/solana": "workspace:*",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0"
  }
}
